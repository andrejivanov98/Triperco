# Google Generative AI (Gemini) — used by the planner agent
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here
# Optional: pick the Gemini model (default gemini-2.5-flash). Newest flash recommended.
GEMINI_MODEL=gemini-2.5-flash

# SearchApi.io — used by the search tools
SEARCHAPI_API_KEY=your_searchapi_key_here

# Upstash Redis (shareable trips) — provisioned via Vercel Marketplace.
# Leave unset locally to use the in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The site's public origin, used for canonical links, og:image and robots/sitemap URLs.
# Set this in Vercel once a custom domain is live — it is the only way to name one, and it is
# read at BUILD time, so changing it needs a redeploy to take effect.
# Left unset it falls back to the Vercel production host, then the deployment host.
NEXT_PUBLIC_SITE_URL=
